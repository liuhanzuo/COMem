# weights / checkpoints / large binaries
*.pt
*.bin
*.safetensors
*.ckpt

# Raw data / predictions / execution outputs stay local. Small aggregate values
# used in the manuscript and plots live explicitly in paper_iclr2027/.
# `*_results/` also catches newly named benchmark output directories.
*_results/
data/
outputs/
ruler_results/
babilong_results/
longbench_results/
longeval_results/
locomo_results/
bench_qcmem_vs_dense_result.txt

# secrets / credentials
configs/password*
*.pem
*.key
.env

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

